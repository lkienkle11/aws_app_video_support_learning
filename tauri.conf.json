{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloud Study",
  "version": "0.1.0",
  "identifier": "local.cloudstudy.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "node scripts/build/core.mjs",
    "beforeDevCommand": "node scripts/build/core.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cloud Study · AWS Learning Studio",
        "width": 1320,
        "height": 880,
        "minWidth": 320,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/cloud-study-core"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline AWS course player",
    "category": "Education"
  }
}
